# ─── Google Sheets ────────────────────────────────────────────────────────────
# Path to service account JSON file (see README for setup steps)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
# The ID from your sheet's URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=

# ─── Enrichment APIs ──────────────────────────────────────────────────────────
# Proxycurl: https://nubela.co/proxycurl — ~$0.01/credit, pay-as-you-go
PROXYCURL_API_KEY=

# Hunter.io: https://hunter.io — free tier = 25 searches/month
HUNTER_API_KEY=

# ─── Proxy (optional, recommended for LinkedIn/Glassdoor) ────────────────────
# Format: http://user:password@host:port
# Leave blank to run without proxy (some scrapers may get blocked)
SCRAPER_PROXY=

# ─── Playwright settings ──────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
# Slow down Playwright actions in ms (increase if getting blocked)
PLAYWRIGHT_SLOW_MO=100

# ─── Pipeline behavior ────────────────────────────────────────────────────────
# How many scrapers to run simultaneously
MAX_CONCURRENT_SCRAPERS=5
# Playwright browsers are memory-hungry — keep this low
MAX_CONCURRENT_PLAYWRIGHT=2
# Days without a scraper sighting before marking a job as Closed
DAYS_BEFORE_MARK_CLOSED=3
# Minimum Hunter.io confidence to include email (0-100)
EMAIL_MIN_CONFIDENCE=50
# Set to true to skip sheet writes (useful for testing)
DRY_RUN=false
# SQLite database path
DB_PATH=./pipeline.db
